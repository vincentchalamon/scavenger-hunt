/**
 * Static Places Cache
 *
 * Ce fichier contient les résultats d'autocomplete pré-générés pour tous les lieux
 * de la chasse au trésor. Il est généré au moment du build et permet de :
 *
 * 1. Éviter les appels API pour les recherches courantes
 * 2. Réduire les coûts Google Maps API de ~50-70% supplémentaires
 * 3. Améliorer les performances (réponse instantanée)
 *
 * Le cache est partagé entre tous les utilisateurs car inclus dans les assets statiques.
 */

export type CachedPlaceResult = {
  placeId: string;
  displayName: string;
  formattedAddress: string;
  location: {
    lat: number;
    lng: number;
  };
};

export type PlacesCache = {
  [searchQuery: string]: CachedPlaceResult[];
};

