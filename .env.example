# Development environment variables
# Copy this file to .env.local for local development

# Thunderforest API Key (optional - for map tiles)
# Get a free API key at https://www.thunderforest.com/pricing/
# Free tier: 150,000 requests/month
# NEXT_PUBLIC_THUNDERFOREST_API_KEY=your_thunderforest_api_key_here

# Base path for deployment (optional)
# If deploying to a subdirectory, set this value
# Example: BASE_PATH=/scavenger-hunt
# Leave empty or unset for root deployment
# BASE_PATH=
