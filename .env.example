# Development environment variables
# Copy this file to .env.local for local development

# Google Maps API Key (for development only)
# In production, this is encrypted and deployed via GitHub Actions
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Build password (used by GitHub Actions workflow)
# This is passed as input when manually triggering the deployment
# BUILD_PASSWORD=unique_password_per_recipient

# Base path for deployment (optional)
# If deploying to a subdirectory, set this value
# Example: BASE_PATH=/scavenger-hunt
# Leave empty or unset for root deployment
# BASE_PATH=
